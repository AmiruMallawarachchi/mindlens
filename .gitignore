*.ipynb_checkpoints

# IDE
.vscode/
.idea/
# Local Claude Code state stays out of git, but project subagents and skills
# are part of the project's engineering setup and should be versioned —
# otherwise they only exist on one machine and are lost on a fresh clone.
.claude/*
!.claude/agents/
!.claude/skills/

# Node (for later)
node_modules/
.next/
dist/
build/

# OS
.DS_Store
Thumbs.db

# Local server logs
backend-server.log
backend-server.err.log
frontend-server.log
frontend-server.err.log

# Jupyter notebooks - keep code, exclude outputs
notebooks/*.ipynb
notebooks/**/*.ipynb
.ipynb_checkpoints/
*.ipynb_checkpoints

# Pulled-back Kaggle kernel copies. Superseded by the canonical notebooks in
