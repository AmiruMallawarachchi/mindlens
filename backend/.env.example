# Runtime
APP_ENV=development
DEBUG=false
RENDER_GIT_COMMIT=local
PORT=8000

# Browser boundary (JSON array or comma-separated origins)
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=mindlens

# Authentication - generate independent values with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-an-independent-64-character-secret
JWT_REFRESH_SECRET_KEY=replace-with-an-independent-64-character-secret
ADMIN_JWT_SECRET=replace-with-an-independent-64-character-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_MINUTES=10080
ADMIN_JWT_EXPIRE_MINUTES=60
ENCRYPTION_KEY=replace-with-a-valid-fernet-key

# AI providers
GROQ_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=false
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mindlens-therapy
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2
PINECONE_TOP_K=5
USE_OPENAI_STUBS=true

# Hosted RAG corpus source used by the one-time Pinecone ingestion command.
RAG_KNOWLEDGE_PATH=backend/data/therapy_knowledge.json

# Security limits
RATE_LIMIT_PER_IP_MINUTE=100
RATE_LIMIT_PER_USER_HOUR=60
RATE_LIMIT_MAX_LOGIN_ATTEMPTS=5
WS_MAX_MESSAGE_CHARS=2000
ADMIN_EMAIL=admin@mindlens.app
