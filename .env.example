UPSTASH_REDIS_URL=rediss://default:password@hostname.upstash.io:6380
JWT_SECRET_KEY=replace-with-256-bit-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
ENCRYPTION_KEY=replace-with-32-byte-base64-key
GROQ_API_KEY=gsk_replace_with_real_key
SPOTIFY_CLIENT_ID=replace-with-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-with-spotify-client-secret
HF_TOKEN=hf_replace_with_real_token
ADMIN_EMAIL=your-admin-email@example.com