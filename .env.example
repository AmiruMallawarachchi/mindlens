# LLM
OPENAI_API_KEY=sk-your-key-here
GROQ_API_KEY=gsk-your-key-here

# Database
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/mindlens?retryWrites=true&w=majority
MONGODB_DB_NAME=mindlens

# Auth
JWT_SECRET_KEY=your-64-char-secret-here-generate-with-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Encryption
ENCRYPTION_KEY=your-base64-32-byte-key-here=

# App
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# Feature Flags
USE_OPENAI_STUBS=true
USE_VOICE=false
USE_SPOTIFY=false

# Admin
ADMIN_EMAIL=admin@mindlens.app