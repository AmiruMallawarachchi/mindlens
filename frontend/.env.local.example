# Copy to .env.local (gitignored) and adjust as needed.

# Where the FastAPI backend listens. REST calls use this directly; the
# WebSocket URL is derived from it (http -> ws, https -> wss). Only set
# NEXT_PUBLIC_WS_BASE_URL separately if the WebSocket endpoint genuinely
# lives somewhere else.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_WS_BASE_URL=

# Renders the chat screen against a fixture instead of requiring a real
# login — useful when working on the UI without a reachable backend.
# NEVER set this to 1 outside local dev: it bypasses authentication
# entirely for every visitor.
# NEXT_PUBLIC_PREVIEW_AUTH=1
